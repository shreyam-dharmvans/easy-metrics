# ==============================================================================
# EASYMETRICS UNIFIED CONFIGURATION (.env.example)
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Local Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easymetrics_db?schema=public"

# Aiven PostgreSQL Example (replace when switching to cloud):
# DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require"

# 2. CORE INGESTION & QUERY API (apps/api - Express.js)
API_PORT=4000
NODE_ENV="development"
# Shared cryptographic secret for signing & verifying user session tokens (used by apps/api and services/ai-agent):
JWT_SECRET="easymetrics-dev-jwt-secret-replace-in-production-min-32-chars"
CORS_ORIGIN="http://localhost:3000"
# Google OAuth Credentials (optional in local dev; falls back to local developer session if empty):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. AI DEBUGGING AGENT & MCP SERVICE (services/ai-agent - FastAPI + LangGraph)
AGENT_PORT=8000
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# 4. DEVELOPER DASHBOARD (apps/web - Next.js 14)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_AGENT_URL="http://localhost:8000"

# 5. DEMO APP & SDK TESTING (examples/demo-app)
EASY_METRICS_API_KEY="em_live_local_dev_key"
EASY_METRICS_ENDPOINT="http://localhost:4000/api/v1/telemetry/ingest"
DEMO_PORT=5000

