{
  "name": "easy-metrics-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-Config Open-Source Observability Platform & AI Debugger",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "npm run dev:db && concurrently -n \"api,web,ai,demo\" -c \"blue,green,magenta,yellow\" \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:ai\" \"npm run dev:demo\"",
    "dev:db": "docker compose up -d",
    "dev:stopdb": "docker compose down",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:ai": "node scripts/run-ai.js",
    "dev:demo": "npm run dev --workspace=examples/demo-app",
    "simulate": "npm run simulate --workspace=examples/demo-app",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:ai": "node scripts/test-ai.js",
    "test:all": "npm test && npm run test:ai"
  },
  "keywords": [
    "observability",
    "apm",
    "opentelemetry",
    "monitoring",
    "langgraph"
  ],
  "author": "EasyMetrics Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}